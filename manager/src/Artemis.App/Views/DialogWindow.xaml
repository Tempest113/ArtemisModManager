<Window x:Class="Artemis.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="440" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg1}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
  <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" MouseLeftButtonDown="OnDrag">
    <StackPanel Margin="24,22,24,20">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
      <TextBox x:Name="Input" Margin="0,16,0,0" Padding="2,4" Visibility="Collapsed" />
      <CheckBox x:Name="OptionBox" Margin="0,14,0,0" Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80" />
        <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="80" Click="OnOk" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
