<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

  <!-- Spacing: one scale, 4 / 8 / 12 / 16. Panels, panes and rows inset 12; header blocks 16; scroll bar column 12. -->

  <!-- Colours: a few dark greys and one accent. Change them here and nowhere else. -->
  <SolidColorBrush x:Key="Bg0" Color="#0F0F11" po:Freeze="True" />
  <SolidColorBrush x:Key="Bg1" Color="#18181B" po:Freeze="True" />
  <SolidColorBrush x:Key="Bg2" Color="#1F1F23" po:Freeze="True" />
  <SolidColorBrush x:Key="Bg3" Color="#27272A" po:Freeze="True" />
  <SolidColorBrush x:Key="PaneBg" Color="#0F0F11" po:Freeze="True" />
  <SolidColorBrush x:Key="Popup" Color="#1C1C20" po:Freeze="True" />
  <SolidColorBrush x:Key="Line" Color="#2A2A2E" po:Freeze="True" />
  <SolidColorBrush x:Key="LineStrong" Color="#3A3A40" po:Freeze="True" />
  <SolidColorBrush x:Key="Text" Color="#E4E4E7" po:Freeze="True" />
  <SolidColorBrush x:Key="Muted" Color="#A1A1AA" po:Freeze="True" />
  <SolidColorBrush x:Key="Faint" Color="#8B8B95" po:Freeze="True" />
  <SolidColorBrush x:Key="Accent" Color="#4C8DFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentInk" Color="#04122E" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentSoft" Color="#2E4C8DFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AccentRow" Color="#1A4C8DFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Bad" Color="#F87171" po:Freeze="True" />
  <SolidColorBrush x:Key="Warn" Color="#FBBF24" po:Freeze="True" />
  <SolidColorBrush x:Key="Hover" Color="#0FFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Press" Color="#1AFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Clear" Color="Transparent" po:Freeze="True" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Icons: code points of Segoe Fluent Icons (Windows 11) / Segoe MDL2 Assets (Windows 10). -->
  <sys:String x:Key="IcoPlay">&#xE768;</sys:String>
  <sys:String x:Key="IcoSearch">&#xE721;</sys:String>
  <sys:String x:Key="IcoAdd">&#xE710;</sys:String>
  <sys:String x:Key="IcoClose">&#xE711;</sys:String>
  <sys:String x:Key="IcoChevDown">&#xE70D;</sys:String>
  <sys:String x:Key="IcoChevUp">&#xE70E;</sys:String>
  <sys:String x:Key="IcoChevRight">&#xE76C;</sys:String>
  <sys:String x:Key="IcoChevLeft">&#xE76B;</sys:String>
  <sys:String x:Key="IcoFolder">&#xE8B7;</sys:String>
  <sys:String x:Key="IcoSync">&#xE72C;</sys:String>
  <sys:String x:Key="IcoSettings">&#xE713;</sys:String>
  <sys:String x:Key="IcoFilter">&#xE71C;</sys:String>
  <sys:String x:Key="IcoTag">&#xE8EC;</sys:String>
  <sys:String x:Key="IcoWarn">&#xE7BA;</sys:String>
  <sys:String x:Key="IcoInfo">&#xE946;</sys:String>
  <sys:String x:Key="IcoCheck">&#xE73E;</sys:String>
  <sys:String x:Key="IcoDelete">&#xE74D;</sys:String>
  <sys:String x:Key="IcoEdit">&#xE70F;</sys:String>
  <sys:String x:Key="IcoMore">&#xE712;</sys:String>
  <sys:String x:Key="IcoMin">&#xE921;</sys:String>
  <sys:String x:Key="IcoMax">&#xE922;</sys:String>
  <sys:String x:Key="IcoRestore">&#xE923;</sys:String>
  <sys:String x:Key="IcoWinClose">&#xE8BB;</sys:String>
  <sys:String x:Key="IcoLibrary">&#xE8F1;</sys:String>
  <sys:String x:Key="IcoUp">&#xE74A;</sys:String>
  <sys:String x:Key="IcoDown">&#xE74B;</sys:String>
  <sys:String x:Key="IcoGrip">&#xE784;</sys:String>
  <sys:String x:Key="IcoSave">&#xE74E;</sys:String>
  <sys:String x:Key="IcoUndo">&#xE7A7;</sys:String>
  <sys:String x:Key="IcoLayers">&#xE81E;</sys:String>
  <sys:String x:Key="IcoLink">&#xE71B;</sys:String>
  <sys:String x:Key="IcoCollapse">&#xE8A0;</sys:String>
  <sys:String x:Key="IcoDiff">&#xE8AB;</sys:String>
  <sys:String x:Key="IcoResume">&#xE72A;</sys:String>
  <sys:String x:Key="IcoPlugin">&#xE943;</sys:String>
  <sys:String x:Key="IcoNote">&#xE90A;</sys:String>
  <sys:String x:Key="IcoLog">&#xE8A5;</sys:String>

  <!-- Achievement marks on a 16 x 16 grid (no font has them): a trophy for a mod that leaves achievements on, a cracked one for a mod that turns them off. -->
  <DrawingImage x:Key="TrophyOk" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="{StaticResource Muted}"
                         Geometry="M4.5,1.5 H11.5 V6.2 C11.5,8.5 10,9.8 8,9.8 C6,9.8 4.5,8.5 4.5,6.2 Z M7.1,9.6 H8.9 V12 H7.1 Z M5.2,12.4 H10.8 V14.3 H5.2 Z" />
        <GeometryDrawing Geometry="M4.5,2.6 H2.3 V5.2 C2.3,6.7 3.4,7.7 5,7.9 M11.5,2.6 H13.7 V5.2 C13.7,6.7 12.6,7.7 11,7.9">
          <GeometryDrawing.Pen><Pen Brush="{StaticResource Muted}" Thickness="1.3" LineJoin="Round" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="TrophyBroken" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
        <!-- The trophy of TrophyOk split along a jagged crack, each half tilted 15 degrees away from the other about the middle of the base, so they make a V.
             Scaled down to keep the splayed halves inside the grid. -->
        <DrawingGroup>
          <DrawingGroup.Transform><ScaleTransform ScaleX="0.88" ScaleY="0.88" CenterX="8" CenterY="8" /></DrawingGroup.Transform>
          <DrawingGroup>
            <DrawingGroup.Transform><RotateTransform Angle="-15" CenterX="8" CenterY="14.3" /></DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Text}">
              <GeometryDrawing.Geometry>
                <CombinedGeometry GeometryCombineMode="Intersect">
                  <CombinedGeometry.Geometry1>
                    <PathGeometry Figures="M4.5,1.5 H11.5 V6.2 C11.5,8.5 10,9.8 8,9.8 C6,9.8 4.5,8.5 4.5,6.2 Z M7.1,9.6 H8.9 V12 H7.1 Z M5.2,12.4 H10.8 V14.3 H5.2 Z" />
                  </CombinedGeometry.Geometry1>
                  <CombinedGeometry.Geometry2>
                    <PathGeometry Figures="M-5,0 L7.9,0 L6.9,3.6 L8.5,5.6 L7.3,7.6 L8,9.4 L8,16 L-5,16 Z" />
                  </CombinedGeometry.Geometry2>
                </CombinedGeometry>
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M4.5,2.6 H2.3 V5.2 C2.3,6.7 3.4,7.7 5,7.9">
              <GeometryDrawing.Pen><Pen Brush="{StaticResource Text}" Thickness="1.3" LineJoin="Round" /></GeometryDrawing.Pen>
            </GeometryDrawing>
          </DrawingGroup>
          <DrawingGroup>
            <DrawingGroup.Transform><RotateTransform Angle="15" CenterX="8" CenterY="14.3" /></DrawingGroup.Transform>
            <GeometryDrawing Brush="{StaticResource Text}">
              <GeometryDrawing.Geometry>
                <CombinedGeometry GeometryCombineMode="Intersect">
                  <CombinedGeometry.Geometry1>
                    <PathGeometry Figures="M4.5,1.5 H11.5 V6.2 C11.5,8.5 10,9.8 8,9.8 C6,9.8 4.5,8.5 4.5,6.2 Z M7.1,9.6 H8.9 V12 H7.1 Z M5.2,12.4 H10.8 V14.3 H5.2 Z" />
                  </CombinedGeometry.Geometry1>
                  <CombinedGeometry.Geometry2>
                    <PathGeometry Figures="M21,0 L7.9,0 L6.9,3.6 L8.5,5.6 L7.3,7.6 L8,9.4 L8,16 L21,16 Z" />
                  </CombinedGeometry.Geometry2>
                </CombinedGeometry>
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M11.5,2.6 H13.7 V5.2 C13.7,6.7 12.6,7.7 11,7.9">
              <GeometryDrawing.Pen><Pen Brush="{StaticResource Text}" Thickness="1.3" LineJoin="Round" /></GeometryDrawing.Pen>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingGroup>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>
</ResourceDictionary>
